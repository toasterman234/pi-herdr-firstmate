# Copy to a private local file; do not commit live values.
# These paths are intentionally separate from the existing Central Ops/Pi profile.
PI_PROFILE_NAME=firstmate-fleet
PI_CODING_AGENT_DIR=$HOME/.pi/firstmate-fleet
PI_CODING_AGENT_SESSION_DIR=$HOME/.pi/firstmate-fleet/sessions
FM_HOME=$HOME/.firstmate/captain
FM_CAPTAIN_SESSION=fm-captain

# Set these only in the local environment used for the pilot.
# FIRSTMATE_ROOT=/absolute/path/to/firstmate
# FIRSTMATE_REPO_URL=https://github.com/kunchenguid/firstmate
